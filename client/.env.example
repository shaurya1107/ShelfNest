# ShelfNest Client – Environment Variables
# Copy this file to .env.local for local development
# Set VITE_API_URL in Vercel's project settings for production

# Backend API URL (your Render service URL)
# For local dev, leave this unset — Vite proxy handles /api → localhost:5000
VITE_API_URL=https://your-render-service.onrender.com/api
