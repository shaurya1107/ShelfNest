# ShelfNest Server – Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL Database Connection (from Neon, Supabase, etc.)
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST/DBNAME?sslmode=require"

# JWT Secret – use a long, random string in production
JWT_SECRET=replace_with_a_strong_random_secret

# Server Port (Render sets this automatically)
PORT=5000

# Allowed frontend origin for CORS (your Vercel deployment URL)
CLIENT_URL=https://your-app.vercel.app

# Cloudinary – for persistent image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
